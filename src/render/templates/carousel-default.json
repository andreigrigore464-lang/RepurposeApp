          "height": 340,
          "font_family": "Inter",
          "font_size": 32,
          "line_height": 1.5,
          "color": "#52525b",
          "auto_shrink_font": true
        },
        {
          "id": "closing-cta-box",
          "type": "shape",
          "shape_type": "rect",
          "x": 90,
          "y": 980,
          "width": 900,
          "height": 120,
          "fill": "#18181b",
          "border_radius": 10
