        {
          "id": "closing-cta-text",
          "type": "text",
          "slot": "closing_slide.call_to_action",
          "default_text": "",
          "x": 130,
          "y": 1022,
          "width": 820,
          "height": 40,
          "font_family": "Inter",
          "font_size": 28,
          "font_weight": "bold",
          "color": "#ffffff",
          "text_align": "center"
        }
      ]
    }
