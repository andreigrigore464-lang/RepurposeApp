        {
          "id": "body-text",
          "type": "text",
          "slot": "body_slide.body",
          "default_text": "",
          "x": 90,
          "y": 500,
          "width": 900,
          "height": 550,
          "font_family": "Inter",
          "font_size": 34,
          "line_height": 1.5,
          "color": "#3f3f46",
          "auto_shrink_font": true
        },
        {
          "id": "body-divider",
