{
  "id": "carousel-default",
  "name": "Classic Editorial Carousel",
  "format": "carousel",
  "dimensions": {
    "width": 1080,
    "height": 1350
  },
  "pages": [
    {
      "page_index": 0,
      "background": {
        "color": "#18181b"
      },
      "elements": [
        {
          "id": "cover-kicker",
          "type": "text",
          "slot": "cover_slide.kicker",
          "default_text": "EDITORIAL DECK",
          "x": 90,
          "y": 140,
          "width": 900,
          "height": 40,
          "font_family": "Inter",
          "font_size": 22,
          "font_weight": "700",
          "color": "#3b82f6"
        },
        {
          "id": "cover-title",
          "type": "text",
          "slot": "cover_slide.title",
          "default_text": "",
          "x": 90,
          "y": 280,
          "width": 900,
          "height": 450,
          "font_family": "Playfair Display",
          "font_size": 64,
          "font_weight": "bold",
          "line_height": 1.25,
          "color": "#ffffff",
          "auto_shrink_font": true
        },
        {
          "id": "cover-subtitle",
          "type": "text",
          "slot": "cover_slide.subtitle",
          "default_text": "",
          "x": 90,
          "y": 780,
          "width": 900,
          "height": 220,
          "font_family": "Inter",
          "font_size": 32,
          "line_height": 1.4,
          "color": "#a1a1aa",
          "auto_shrink_font": true
        },
        {
          "id": "cover-swipe-indicator",
