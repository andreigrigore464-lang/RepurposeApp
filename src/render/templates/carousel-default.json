          "width": 400,
          "height": 40,
          "font_family": "Inter",
          "font_size": 20,
          "font_weight": "700",
          "color": "#3b82f6"
        }
      ]
    },
    {
      "page_index": 1,
      "background": {
        "color": "#ffffff"
      },
      "elements": [
        {
          "id": "body-badge",
